{
  "name": "bb-plugin-thread-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "bb": ">=0.40.0", "bbPluginSdk": ">=0.4.21" },
  "bb": {
    "name": "Thread Mobile",
    "description": "Mobile previous/next arrows and safe swipe navigation between project threads.",
    "branding": { "icon": "ArrowLeftRight" },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateoCerquetella/bb-plugins.git",
    "directory": "plugins/thread-mobile"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "bb-app": "0.40.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
