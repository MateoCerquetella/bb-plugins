{
  "compilerOptions": {
    "strict": true, "target": "ES2022", "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"], "noEmit": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts", "*.tsx", "lib/**/*.ts", "components/**/*.tsx", "test/**/*.ts"]
}
