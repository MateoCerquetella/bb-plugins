{
  "name": "bb-plugin-touchbar",
  "version": "0.1.2",
  "private": true,
  "description": "Native persistent BB agent and thread status for MacBook Pro Touch Bars.",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "type": "module",
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Touch Bar Agent Monitor",
    "description": "Native fullscreen BB thread status and guarded controls for Touch Bar Macs.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "assets/",
    "companion/",
    "native/",
    "README.md",
    "LICENSE",
    "server.ts",
    "lib/"
  ],
  "dependencies": {},
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "bb-app": "^0.40.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "tsx": "^4.23.12",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  }
}
