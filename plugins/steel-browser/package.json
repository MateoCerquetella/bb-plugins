    "branding": {
      "icon": "./assets/nav-icon.svg",
      "logo": {
        "light": "./assets/icon.svg",
        "dark": "./assets/icon.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/steel-browser"
    ]
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "app.css",
    "contract.ts",
    "server.ts",
    "steel-client.ts",
    "projects.ts",
    "rpc-timeout.ts",
    "use-follow-viewer.ts",
    "use-panel-expansion.ts",
    "engines.ts",
    "jev-runtime.ts",
    "actions.ts",
    "navigation.ts",
    "viewer-protocol.ts",
    "viewer-relay.ts",
    "live-viewer.tsx",
    "service-catalog.ts",
    "sign-ins.ts",
    "sign-ins-panel.tsx",
    "dashboard-cache.ts",
    "provisioning.ts",
    "scripts/"
  ],
  "dependencies": {
    "lucide-react": "^1.49.0",
    "playwright": "1.63.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.2",
    "bb-app": "0.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.0",
    "vaul": "^1.1.2",
    "ws": "^8.22.0"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  }
}
