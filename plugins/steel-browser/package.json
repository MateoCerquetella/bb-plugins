{
  "name": "bb-plugin-steel-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Run and manage self-hosted Steel browser sessions from BB.",
  "type": "module",
  "license": "MIT",
  "author": "Mateo Cerquetella",
  "homepage": "https://github.com/MateoCerquetella/bb-plugins/tree/main/plugins/steel-browser#readme",
  "bugs": {
    "url": "https://github.com/MateoCerquetella/bb-plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateoCerquetella/bb-plugins.git",
    "directory": "plugins/steel-browser"
  },
  "keywords": [
    "bb",
    "bb-plugin",
    "steel",
    "browser",
    "browser-automation"
  ],
  "engines": {
    "bb": ">=0.40",
    "bbPluginSdk": ">=0.4.21"
  },
  "bb": {
    "name": "Steel Browser",
    "description": "Operate self-hosted Steel browser sessions from BB.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "./skills/steel-browser"
    ]
  },
  "files": [
    "dist/",
    "assets/",
    "skills/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "app.tsx",
    "app.css",
    "contract.ts",
    "server.ts",
    "steel-client.ts"
  ],
  "dependencies": {
    "lucide-react": "^1.49.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.21",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^7.0.0",
    "vaul": "^1.1.2"
  },
  "scripts": {
    "build": "env -u BB_CLI bb plugin build .",
    "dev": "bb plugin dev .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "types:refresh": "env -u BB_CLI bb plugin types .",
    "test": "node --test --experimental-transform-types test/*.test.ts",
    "check": "npm run types:check && npm run typecheck && npm test && npm run build"
  }
}
