{
  "name": "bb-plugin-agent-canvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A persistent spatial workbench for live BB agents, notes and connected context.",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Agent Canvas",
    "description": "A persistent spatial workbench for live BB agents, notes and connected context.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.44.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.ts",
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check .",
    "check": "npm run typecheck && npm run test && npm run types:check && npm run build"
  }
}
