{
  "name": "bb-plugin-agent-canvas",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A spatial canvas for live BB agent threads with a Coordinator dock.",
  "type": "module",
  "engines": { "bb": ">=0.44", "bbPluginSdk": ">=0.5.29" },
  "bb": {
    "name": "Agent Canvas",
    "description": "Spatial live agent canvas and Coordinator workspace.",
    "branding": { "icon": "Workflow" },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": { "zod": "^4.3.6" },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "bb-app": "0.44.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test *.test.ts",
    "build": "env -u BB_CLI bb plugin build .",
    "typecheck": "tsc --noEmit",
    "types:check": "env -u BB_CLI bb plugin types --check ."
  }
}
