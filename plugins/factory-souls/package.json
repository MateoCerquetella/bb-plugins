    "dist/app.css",
    "assets/",
    "factory.mcp.json",
    "README.md",
    "LICENSE",
    "server.ts",
    "app.tsx",
    "app.css",
    "contract.ts",
    "lib/"
  ],
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.29",
    "@types/node": "^22.0.0",
